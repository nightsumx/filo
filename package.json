{
    "name": "filo",
    "productName": "Filo",
    "private": true,
    "version": "0.3.1",
    "description": "编码 Agent 的 Mac 工作台：多项目多线程并行，改动归属到线程，独立审查，搜索所有会话",
    "author": "sum",
    "license": "MIT",
    "homepage": "https://filoapp.dev",
    "desktopName": "filo.desktop",
    "type": "module",
    "main": "dist-electron/main/main.js",
    "trustedDependencies": ["electron", "node-pty"],
    "workspaces": ["packages/*"],
    "scripts": {
        "dev": "vite",
        "postinstall": "node scripts/dev-app-name.mjs && node scripts/pty-helper.mjs",
        "build": "tsc -b && vite build",
        "typecheck": "tsc -b",
        "test": "vitest run",
        "density": "bun --tsconfig-override=tsconfig.node.json test/density.ts",
        "e2e:windows": "bun --tsconfig-override=tsconfig.node.json test/windows.ts",
        "e2e:features": "bun --tsconfig-override=tsconfig.node.json test/features.ts",
        "e2e:subagents": "bun --tsconfig-override=tsconfig.node.json test/subagents-e2e.ts",
        "e2e:review": "bun --tsconfig-override=tsconfig.node.json test/review-e2e.ts",
        "e2e:providers": "bun --tsconfig-override=tsconfig.node.json test/providers-e2e.ts",
        "e2e:acp": "bun --tsconfig-override=tsconfig.node.json test/acp-e2e.ts",
        "e2e:terminal": "bun --tsconfig-override=tsconfig.node.json test/terminal-e2e.ts",
        "e2e:codex": "bun --tsconfig-override=tsconfig.node.json test/codex-e2e.ts",
        "e2e:shell": "bun --tsconfig-override=tsconfig.node.json test/shell-e2e.ts",
        "e2e:shell-agent": "bun --tsconfig-override=tsconfig.node.json test/shell-agent-e2e.ts",
        "site:shots": "bun --tsconfig-override=tsconfig.node.json site/shots.ts",
        "deploy:site": "cp scripts/install.sh site/public/install.sh && wrangler deploy -c site/wrangler.jsonc",
        "preview": "vite preview",
        "dist": "bun run build && scripts/bundle-pi.sh && electron-builder --publish never",
        "dist:dir": "bun run build && electron-builder --dir --publish never"
    },
    "dependencies": {
        "@fontsource-variable/inter": "5.3.0",
        "@fontsource-variable/jetbrains-mono": "5.3.0",
        "@git-diff-view/file": "0.1.5",
        "@git-diff-view/lowlight": "0.1.5",
        "@git-diff-view/react": "0.1.5",
        "@radix-ui/react-context-menu": "2.2.14",
        "@radix-ui/react-dialog": "1.1.13",
        "@radix-ui/react-dropdown-menu": "2.1.14",
        "@radix-ui/react-popover": "1.1.13",
        "@radix-ui/react-slot": "1.2.2",
        "@radix-ui/react-tooltip": "1.2.6",
        "@tanstack/react-virtual": "3.13.24",
        "@xterm/addon-fit": "0.11.0",
        "@xterm/addon-web-links": "0.12.0",
        "@xterm/addon-webgl": "0.19.0",
        "@xterm/xterm": "6.0.0",
        "class-variance-authority": "0.7.1",
        "clsx": "2.1.1",
        "copy-to-clipboard": "3.3.3",
        "dayjs": "1.11.13",
        "diff": "8.0.4",
        "github-markdown-css": "5.8.1",
        "highlight.js": "11.11.1",
        "lucide-react": "0.503.0",
        "mobx": "6.13.7",
        "mobx-react-lite": "4.1.0",
        "react": "19.1.0",
        "react-dom": "19.1.0",
        "react-markdown": "10.1.0",
        "remark-gfm": "4.0.1",
        "sonner": "2.0.5",
        "tailwind-merge": "3.2.0"
    },
    "devDependencies": {
        "@earendil-works/pi-coding-agent": "1.0.3",
        "@lobehub/icons-static-svg": "1.95.1",
        "@tailwindcss/typography": "0.5.16",
        "@types/node": "22.15.17",
        "@types/react": "19.1.3",
        "@types/react-dom": "19.1.3",
        "@vitejs/plugin-react": "6.0.2",
        "@xterm/addon-serialize": "0.14.0",
        "@xterm/headless": "6.0.0",
        "autoprefixer": "10.4.21",
        "electron": "37.10.3",
        "electron-builder": "26.15.3",
        "node-pty": "1.1.0",
        "pi-capabilities": "workspace:*",
        "postcss": "8.5.3",
        "tailwindcss": "3.4.17",
        "tailwindcss-animate": "1.0.7",
        "typebox": "1.3.27",
        "typescript": "5.7.3",
        "vite": "8.0.13",
        "vite-plugin-electron": "0.29.1",
        "vite-plugin-electron-renderer": "0.14.6",
        "vitest": "3.1.3"
    },
    "build": {
        "appId": "dev.nightsumx.filo",
        "productName": "Filo",
        "directories": {
            "output": "release",
            "buildResources": "build"
        },
        "files": [
            "dist/**",
            "dist-electron/**",
            "package.json",
            "!**/node_modules/**"
        ],
        "extraResources": [
            {
                "from": "electron/providerHelper.mts",
                "to": "providerHelper.mts"
            },
            {
                "from": "electron/piLauncher.mjs",
                "to": "piLauncher.mjs"
            },
            {
                "from": "packages/capabilities",
                "to": "capabilities",
                "filter": [
                    "package.json",
                    "protocol.ts",
                    "extensions/**",
                    "tui/**",
                    "lib/**"
                ]
            }
        ],
        "npmRebuild": false,
        "toolsets": {
            "appimage": "1.0.3"
        },
        "mac": {
            "icon": "build/icon.icns",
            "category": "public.app-category.developer-tools",
            "identity": "-",
            "hardenedRuntime": false,
            "target": [
                "dmg",
                "zip"
            ],
            "extraResources": [
                {
                    "from": "bundled-pi/node_modules",
                    "to": "pi/node_modules",
                    "filter": [
                        "**/*",
                        "!**/*.map",
                        "!**/*.d.ts",
                        "!**/*.d.mts",
                        "!**/*.d.cts",
                        "!**/prebuilds/{linux,win32}-*/**"
                    ]
                },
                {
                    "from": "node_modules/node-pty",
                    "to": "node-pty",
                    "filter": [
                        "package.json",
                        "lib/**/*.js",
                        "!lib/**/*.test.js",
                        "!lib/worker/**",
                        "!lib/*windows*",
                        "!lib/conpty*",
                        "prebuilds/darwin-*/**"
                    ]
                }
            ]
        },
        "win": {
            "target": [
                "nsis"
            ],
            "artifactName": "Filo-Setup-${arch}.${ext}",
            "extraResources": [
                {
                    "from": "bundled-pi/node_modules",
                    "to": "pi/node_modules",
                    "filter": [
                        "**/*",
                        "!**/*.map",
                        "!**/*.d.ts",
                        "!**/*.d.mts",
                        "!**/*.d.cts",
                        "!**/prebuilds/{darwin,linux}-*/**"
                    ]
                },
                {
                    "from": "node_modules/node-pty",
                    "to": "node-pty",
                    "filter": [
                        "package.json",
                        "lib/**/*.js",
                        "!lib/**/*.test.js",
                        "prebuilds/win32-*/**",
                        "!**/*.pdb"
                    ]
                }
            ]
        },
        "nsis": {
            "oneClick": true,
            "perMachine": false,
            "shortcutName": "Filo"
        },
        "linux": {
            "target": [
                "AppImage"
            ],
            "icon": "build/icon.png",
            "category": "Development",
            "executableName": "filo",
            "syncDesktopName": true,
            "artifactName": "Filo-${arch}.${ext}",
            "extraResources": [
                {
                    "from": "bundled-pi/node_modules",
                    "to": "pi/node_modules",
                    "filter": [
                        "**/*",
                        "!**/*.map",
                        "!**/*.d.ts",
                        "!**/*.d.mts",
                        "!**/*.d.cts",
                        "!**/prebuilds/{darwin,win32}-*/**"
                    ]
                },
                {
                    "from": "node_modules/node-pty",
                    "to": "node-pty",
                    "filter": [
                        "package.json",
                        "lib/**/*.js",
                        "!lib/**/*.test.js",
                        "!lib/worker/**",
                        "!lib/*windows*",
                        "!lib/conpty*",
                        "build/Release/pty.node"
                    ]
                }
            ]
        }
    }
}
