{
  "name": "pi-cc-tui",
  "version": "0.1.0",
  "description": "Make pi's TUI look like Claude Code: messages, markdown, spinner, input box, status line and dark theme",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "claude-code",
    "theme",
    "statusline"
  ],
  "license": "MIT",
  "author": "nightsumx",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nightsumx/pi-kit.git",
    "directory": "packages/pi-cc-tui"
  },
  "homepage": "https://github.com/nightsumx/pi-kit/tree/main/packages/pi-cc-tui#readme",
  "type": "module",
  "scripts": {
    "prepack": "node scripts/bundle-capabilities.mjs",
    "postpack": "node scripts/bundle-capabilities.mjs --restore"
  },
  "pi": {
    "extensions": [
      "./extensions/cc-tui.ts",
      "./extensions/cc-statusline.ts",
      "./extensions/cc-compaction.ts",
      "./extensions/cc-transcript.ts",
      "./extensions/cc-input.ts",
      "./extensions/cc-modes.ts",
      "./extensions/cc-header.ts",
      "./extensions/cc-presence.ts",
      "./extensions/cc-bridge.ts",
      "./extensions/capabilities/todo.ts",
      "./extensions/capabilities/ask.ts",
      "./extensions/capabilities/approval.ts",
      "./extensions/capabilities/plan.ts",
      "./extensions/capabilities/subagent.ts",
      "./extensions/capabilities/review.ts"
    ],
    "themes": [
      "./themes/claude-code.json",
      "./themes/claude-code-light.json"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "dependencies": {
    "pi-capabilities": "0.1.0"
  },
  "bundledDependencies": [
    "pi-capabilities"
  ],
  "files": [
    "extensions",
    "themes",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ]
}
