{
  "name": "pi-cc-tui",
  "version": "0.1.0",
  "description": "Make pi's TUI look like Claude Code: messages, markdown, spinner, input box, status line and dark theme",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "claude-code",
    "theme",
    "statusline"
  ],
  "license": "MIT",
  "author": "nightsumx",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nightsumx/pi-cc-tui.git"
  },
  "homepage": "https://github.com/nightsumx/pi-cc-tui#readme",
  "type": "module",
  "pi": {
    "extensions": [
      "./extensions/cc-tui.ts",
      "./extensions/cc-statusline.ts",
      "./extensions/cc-compaction.ts",
      "./extensions/cc-transcript.ts",
      "./extensions/cc-input.ts",
      "./extensions/cc-permissions.ts",
      "./extensions/cc-todo.ts",
      "./extensions/cc-header.ts"
    ],
    "themes": [
      "./themes/claude-code.json",
      "./themes/claude-code-light.json"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "files": [
    "extensions",
    "themes",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ]
}
